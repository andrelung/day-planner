# Copy to .env for local `npm run dev` (outside Docker Compose, which
# injects these directly from the root .env instead — see ../docker-compose.yml).

DATABASE_URL="postgresql://dayplanner:dayplanner@localhost:5432/dayplanner?schema=public"

# 32-byte key (base64) used to encrypt OAuth tokens at rest. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_JWT_SECRET=""

PORT=3000
PUBLIC_APP_URL="http://localhost:3000"

# --- Asana OAuth app (https://app.asana.com/0/developer-console) ---
ASANA_CLIENT_ID=""
ASANA_CLIENT_SECRET=""

# --- Microsoft Entra ID app registration (https://entra.microsoft.com) ---
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_TENANT_ID="common"
