// Day Planner backend data model.
// Tokens are stored encrypted at rest (see src/lib/crypto.ts) — this schema
// only ever sees ciphertext, never a raw Asana/Microsoft access token.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  ASANA
  OUTLOOK
}

model User {
  id              String   @id @default(uuid())
  primaryProvider Provider
  createdAt       DateTime @default(now())

  accounts  OAuthAccount[]
  settings  Settings?
  eventLinks CalendarEventLink[]
}

/// One row per connected provider account (Asana and/or Outlook) for a user.
model OAuthAccount {
  id     String   @id @default(uuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider Provider

  /// The provider's own user id (Asana user gid / Microsoft Graph user id).
  /// Used to recognize a returning user on a fresh login, independent of
  /// which User.id we assigned them locally.
  externalAccountId String

  /// AES-256-GCM ciphertext, base64: iv + authTag + ciphertext packed together.
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime?
  scope           String?

  /// Provider account identity, for display only (e.g. email/name) — never a secret.
  accountLabel String?

  createdAt DateTime @updatedAt
  updatedAt DateTime @default(now())

  @@unique([userId, provider])
  @@unique([provider, externalAccountId])
}

/// Per-user app preferences (mirrors the Settings screen).
model Settings {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prefStartTime  String   @default("09:00")
  prefEndTime    String   @default("18:00")
  bufferMinutes  Int      @default(10)
  /// IANA timezone name (e.g. "Europe/Berlin"), used to display due dates
  /// and change-log timestamps in the user's own local time instead of UTC.
  timezone       String   @default("UTC")
  updatedAt      DateTime @updatedAt
}

/// Persists the "linked to task" / "added as task" state for an Outlook
/// calendar event, since that's local app state Graph doesn't know about.
model CalendarEventLink {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Microsoft Graph event id.
  externalEventId    String
  linkedAsanaTaskGid String
  linkedTaskName     String
  createdAt          DateTime @default(now())

  @@unique([userId, externalEventId])
}
