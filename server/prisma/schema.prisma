// Day Planner backend data model.
// Tokens are stored encrypted at rest (see src/lib/crypto.ts) — this schema
// only ever sees ciphertext, never a raw Asana/Microsoft access token.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  ASANA
  OUTLOOK
}

enum PendingActionStatus {
  PENDING
  FAILED
  DONE
}

model User {
  id              String   @id @default(uuid())
  primaryProvider Provider
  createdAt       DateTime @default(now())

  accounts  OAuthAccount[]
  settings  Settings?
  eventLinks CalendarEventLink[]
  pendingActions PendingAction[]
  ignoredEventTitles IgnoredEventTitle[]
  declinedAutoIgnoreTitles DeclinedAutoIgnoreTitle[]
}

/// One row per connected provider account (Asana and/or Outlook) for a user.
model OAuthAccount {
  id     String   @id @default(uuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider Provider

  /// The provider's own user id (Asana user gid / Microsoft Graph user id).
  /// Used to recognize a returning user on a fresh login, independent of
  /// which User.id we assigned them locally.
  externalAccountId String

  /// AES-256-GCM ciphertext, base64: iv + authTag + ciphertext packed together.
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime?
  scope           String?

  /// Provider account identity, for display only (e.g. email/name) — never a secret.
  accountLabel String?

  /// Cached Asana workspace membership (gid/name pairs) — see
  /// providers/asana.ts's listWorkspaces. Persisted (not just kept in that
  /// file's own in-memory cache) because the live /users/me call it backs
  /// has been confirmed, twice, to occasionally take 15-25+ seconds — real
  /// latency on Asana's side this app can't fix by retrying faster, only by
  /// calling it as rarely as workspace membership (which essentially never
  /// changes for a real user) actually requires. Only ever set for
  /// provider = ASANA; left null for OUTLOOK rows.
  workspacesJson     Json?
  workspacesCachedAt DateTime?

  createdAt DateTime @updatedAt
  updatedAt DateTime @default(now())

  @@unique([userId, provider])
  @@unique([provider, externalAccountId])
}

/// Per-user app preferences (mirrors the Settings screen).
model Settings {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prefStartTime  String   @default("09:00")
  prefEndTime    String   @default("18:00")
  bufferMinutes  Int      @default(10)
  /// IANA timezone name (e.g. "Europe/Berlin"), used to display due dates
  /// and change-log timestamps in the user's own local time instead of UTC.
  timezone       String   @default("UTC")
  /// Skips the day-full warning ("Today already looks full") entirely,
  /// regardless of how over capacity a day is. The per-day-only version of
  /// that dismissal is client-side (localStorage), not here — it's a
  /// lighter-weight, session-ish preference that doesn't need to be a real
  /// setting a user manages. Distinct from confirmDoubleBooking below —
  /// this is about total planned *hours* on a day, that's about two things
  /// landing at the exact same *time*.
  skipDayFullWarning Boolean @default(false)
  /// Whether to show the "is already booked" screen when a placement
  /// genuinely conflicts with another task/event at the same instant.
  /// Defaults true (ask) — turning it off silently double-books instead,
  /// same as always tapping "Double-book anyway" would.
  confirmDoubleBooking Boolean @default(true)
  /// Whether this user has completed onboarding (welcome carousel +
  /// workday setup). Account-level, not device-local: the setup screen is a
  /// one-time thing per *user*, so signing in on a second device must not
  /// ask again. The client keeps a localStorage mirror purely as a pre-auth
  /// placeholder (it has to decide whether to show the welcome carousel
  /// before there's any session to read this from) — see store.svelte.ts.
  hasOnboarded Boolean @default(false)
  /// Whether Triage's "Up next" list is collapsed — synced across devices
  /// (unlike the per-day-full dismissal above) since it's a deliberate
  /// layout choice the user makes once, not a session-ish thing.
  upNextCollapsed Boolean @default(false)
  updatedAt      DateTime @updatedAt
}

/// A queued Asana write (set due date/time, set hours estimate, ...) that's
/// applied by a background worker instead of blocking the request that
/// triggered it — see lib/pendingActionQueue.ts. `payload` carries whatever
/// the worker needs to actually perform (and retry) the write; `label` is
/// a plain-English summary for the Settings lookup UI, since `payload` is
/// an implementation detail the user shouldn't have to parse.
model PendingAction {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String
  payload       Json
  label         String
  status        PendingActionStatus @default(PENDING)
  attempts      Int                 @default(0)
  lastError     String?
  /// Not eligible to be picked up by the worker again until this time —
  /// used for retry backoff. Defaults to "now" so a freshly-enqueued action
  /// is immediately eligible.
  nextAttemptAt DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, nextAttemptAt])
}

/// Persists the "linked to task" / "added as task" / "ignored" state for an
/// Outlook calendar event, since that's local app state Graph doesn't know
/// about. A row is either a link (linkedAsanaTaskGid set) or a dismissal
/// (ignored true) — see routes/calendar.ts, which keeps the two mutually
/// exclusive rather than the schema enforcing it.
model CalendarEventLink {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Microsoft Graph event id.
  externalEventId    String
  linkedAsanaTaskGid String?
  linkedTaskName     String?
  /// The task's own Asana permalink — lets a calendar-entry detail panel
  /// open the linked task directly rather than only naming it. Stored at
  /// link time (the client already has it from the search/create result)
  /// rather than re-fetched from Asana on every read.
  linkedTaskPermalinkUrl String?
  /// The user dismissed this event from the Overview list without linking
  /// it to anything.
  ignored            Boolean  @default(false)
  /// The event's own title, stored only when ignored — lets a single-
  /// instance ignore be counted by title (see routes/calendar.ts's
  /// ignoreEventTitleCount) to notice "you've ignored this exact meeting
  /// title before" and offer the always-ignore rule at that point, instead
  /// of asking on every single ignore regardless of whether it's the
  /// user's first time seeing this title at all.
  title              String?
  createdAt          DateTime @default(now())

  @@unique([userId, externalEventId])
}

/// A title the user was asked "always ignore events titled X?" for and
/// said no to — checked alongside IgnoredEventTitle so that "no" actually
/// sticks instead of asking again on every subsequent ignore of the same
/// title. Distinct from IgnoredEventTitle itself (which means the *opposite*
/// — always auto-ignore) rather than reusing it with a status flag, since
/// the two are checked at completely different points (this one only ever
/// gates whether to *ask*, never filters an event list the way
/// IgnoredEventTitle does).
model DeclinedAutoIgnoreTitle {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())

  @@unique([userId, title])
}

/// A standing "always ignore this" rule by exact event title, for a
/// recurring meeting whose Outlook occurrences each carry their own
/// externalEventId (so a single CalendarEventLink ignore only covers one
/// day's instance, not the series — the user has to keep re-ignoring the
/// same meeting every day otherwise). Checked alongside CalendarEventLink
/// in routes/calendar.ts wherever events are listed.
model IgnoredEventTitle {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())

  @@unique([userId, title])
}
