# Copy this file to .env (project root) and fill in real values. This one
# file covers both `docker compose up` (auto-loaded by Docker Compose from
# this exact path) and running the server directly on the host — `npm run
# dev`/`npm test`/`npm run prisma:*` in server/ load it via
# --env-file-if-exists=../.env (see server/package.json). See README.md for
# how to generate the secrets and register the Asana / Microsoft OAuth apps.

# --- Postgres ---
POSTGRES_USER=dayplanner
POSTGRES_PASSWORD=
POSTGRES_DB=dayplanner
# Host port docker-compose publishes `db` on (127.0.0.1 only — see
# DATABASE_URL below). Only matters if 55433 is already taken on your
# machine.
POSTGRES_PORT=55433

# Only used when running the server directly on the host (not via Docker) —
# docker-compose builds its own DATABASE_URL from POSTGRES_* above, using
# the `db` container hostname. This one reaches the same database via the
# port docker-compose.yml publishes for `db` (127.0.0.1 only) — so `docker
# compose up -d db` (or the full stack) needs to be running for bare-metal
# `npm run dev`/`prisma migrate` to work. Keep the user/password in sync
# with POSTGRES_USER/POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://dayplanner:<POSTGRES_PASSWORD>@localhost:55433/dayplanner?schema=public

# --- App secrets (openssl rand -base64 32) ---
TOKEN_ENCRYPTION_KEY=
SESSION_JWT_SECRET=

# --- Where the app is reachable from a browser (used to build OAuth
# redirect URIs — must match what you register with Asana/Microsoft) ---
PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# --- Asana OAuth app: https://app.asana.com/0/developer-console ---
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# --- Microsoft Entra ID app registration: https://entra.microsoft.com ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common

# IANA timezone (e.g. Europe/Berlin). Sets the app process's system clock
# (fixes "Today"/"Tomorrow" day-bucketing to use this zone's day boundary
# instead of UTC) and seeds the default for a brand-new user's Settings ->
# Timezone. Optional — defaults to UTC if unset.
TZ=UTC
