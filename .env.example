# Copy this file to .env and fill in real values before running
# `docker compose up`. See README.md for how to generate the secrets and
# register the Asana / Microsoft OAuth apps.

# --- Postgres ---
POSTGRES_USER=dayplanner
POSTGRES_PASSWORD=
POSTGRES_DB=dayplanner

# --- App secrets (openssl rand -base64 32) ---
TOKEN_ENCRYPTION_KEY=
SESSION_JWT_SECRET=

# --- Where the app is reachable from a browser (used to build OAuth
# redirect URIs — must match what you register with Asana/Microsoft) ---
PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# --- Asana OAuth app: https://app.asana.com/0/developer-console ---
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# --- Microsoft Entra ID app registration: https://entra.microsoft.com ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
